# =============================================================
# GCIS Environment Configuration — EXAMPLE (safe to commit)
# Copy this to .env and fill in real values
# =============================================================

# --- LLM Provider ---
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here

# --- Database ---
DATABASE_URL=postgresql+asyncpg://gcis:gcis_pass@localhost:5432/gcis_db
POSTGRES_USER=gcis
POSTGRES_PASSWORD=gcis_pass
POSTGRES_DB=gcis_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_TAGS=gcis.tags
KAFKA_TOPIC_FEATURES=gcis.features
KAFKA_TOPIC_ALERTS=gcis.alerts

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=gcis_episodes

# --- Agent Thresholds ---
ALERT_THRESHOLD=0.65
MIN_CONFIDENCE=0.4
OPERATOR_AWAIT_TIMEOUT_SEC=180
STALE_TAG_FAST_SEC=10
STALE_TAG_SLOW_SEC=60

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change_me_before_production

# --- Frontend ---
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_BASE=ws://localhost:8000
